# Contact form email delivery (server-side only — never prefix with NEXT_PUBLIC_).
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=shereifelswaf7@gmail.com
# Sender address. Must use a domain verified in Resend. The default
# onboarding@resend.dev sender only delivers to your Resend account's own email.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Public URL of the deployed site (canonical URL, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://shereifahmed.vercel.app
